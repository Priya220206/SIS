# Copy to .env.local for local development. Never commit real values.
# In production, set these in Netlify (Project configuration > Environment variables)
# and trigger a new deploy after changing them: NEXT_PUBLIC_* values are inlined at build time,
# and server functions only pick up new values on the next deploy.

# Supabase (auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Turso (inventory database)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
